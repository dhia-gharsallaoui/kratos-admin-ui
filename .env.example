# Authentication
# Required: Set these to secure your admin UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Set to true to disable authentication (when using network-level security)
# AUTH_DISABLED=false

# Ory Network Configuration
# Set to true when using Ory Network (cloud)
IS_ORY_NETWORK=false

# Ory API Keys (Bearer tokens for authentication)
# Required for Ory Network, optional for self-hosted Ory
# Option 1: Use a single shared API key for both services
ORY_API_KEY=
# Option 2: Use separate API keys (these override ORY_API_KEY if set)
KRATOS_API_KEY=
HYDRA_API_KEY=

# Kratos URLs
# For self-hosted: use separate public/admin URLs
# For Ory Network: both can point to the same URL
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

# Hydra URLs
# For self-hosted: use separate public/admin URLs
# For Ory Network: both can point to the same URL
HYDRA_PUBLIC_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445

# Hydra Integration
# Set to false to disable Hydra integration
# HYDRA_ENABLED=true

# Settings persistence
# Path to JSON file for runtime settings overrides
# SETTINGS_FILE_PATH=./data/settings.json
